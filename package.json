{
  "name": "nostr-zap",
  "version": "1.3.0",
  "description": "Zap any Nostr npub from anywhere.",
  "source": "src/index.js",
  "main": "dist/main.js",
  "targets": {
    "main": {
      "includeNodeModules": true
    },
    "example": {
      "source": "example/index.html",
      "distDir": "example/dist",
      "context": "browser"
    }
  },
  "scripts": {
    "build": "parcel build --target main",
    "dev": "npm run build && parcel --target example --open",
    "prepare": "npm run build",
    "test": "echo TODO"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/SamSamskies/nostr-zap.git"
  },
  "keywords": [
    "nostr",
    "zap",
    "bitcoin",
    "lightning"
  ],
  "author": "Sam Samskies",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SamSamskies/nostr-zap/issues"
  },
  "homepage": "https://github.com/SamSamskies/nostr-zap#readme",
  "devDependencies": {
    "parcel": "2.16.4",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "easyqrcodejs": "4.6.2",
    "nostr-tools": "1.10.1"
  }
}
